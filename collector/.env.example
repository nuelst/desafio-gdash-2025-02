# Collector (Python) - Environment Variables

# RabbitMQ Configuration
RABBITMQ_URI=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=weather-data

# Weather Locations Configuration
# Option 1: Multiple locations (JSON array - RECOMMENDED)
WEATHER_LOCATIONS=[{"name": "São Paulo, BR", "latitude": -23.5505, "longitude": -46.6333}, {"name": "Luanda, Angola", "latitude": -8.8383, "longitude": 13.2344}]

# Option 2: Single location (if WEATHER_LOCATIONS is not set)
# WEATHER_LOCATION=São Paulo, BR
# LOCATION_LATITUDE=-23.5505
# LOCATION_LONGITUDE=-46.6333

# Collection Interval (in seconds)
COLLECTION_INTERVAL_SECONDS=3600

# Open-Meteo API URL (optional, has default)
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
