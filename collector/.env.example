# ============================================
# Python Weather Collector - Variáveis de Ambiente
# ============================================

# RabbitMQ Connection
RABBITMQ_URI=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=weather-data

# Localizações para coletar dados climáticos
# Formato: JSON array com objetos contendo name, latitude, longitude
WEATHER_LOCATIONS=[{"name": "São Paulo, BR", "latitude": -23.5505, "longitude": -46.6333}, {"name": "Luanda, Angola", "latitude": -8.8383, "longitude": 13.2344}]

# Intervalo de coleta em segundos (padrão: 3600 = 1 hora)
# Para desenvolvimento/testes, use valores menores (ex: 60 = 1 minuto)
COLLECTION_INTERVAL_SECONDS=3600

# URL da API Open-Meteo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ============================================
# Notas:
# ============================================
# 1. Para desenvolvimento local:
#    - RABBITMQ_URI: amqp://guest:guest@localhost:5672/
#    - COLLECTION_INTERVAL_SECONDS: 60 (para testes rápidos)
#
# 2. Para Docker Compose:
#    - RABBITMQ_URI: amqp://guest:guest@rabbitmq:5672/
#    - As variáveis são definidas no compose.yml
#
# 3. WEATHER_LOCATIONS:
#    - Deve ser um JSON array válido
#    - Cada objeto deve ter: name, latitude, longitude
#    - Exemplo: [{"name": "Cidade, País", "latitude": -23.5, "longitude": -46.6}]
#
