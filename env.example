# ============================================
# Weather Dashboard - Variáveis de Ambiente
# ============================================
# 
# Este arquivo contém todas as variáveis de ambiente necessárias
# para executar o projeto Weather Dashboard.
#
# Para usar este arquivo:
# 1. Copie este arquivo para .env na raiz do projeto
# 2. Ajuste os valores conforme necessário
# 3. Para Docker Compose, as variáveis podem ser definidas aqui ou no compose.yml
#
# ============================================

# ============================================
# Backend (NestJS API)
# ============================================
NODE_ENV=production
API_PORT=3000
MONGODB_URI=mongodb://mongodb:27017/weather-dashboard
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=123456
FRONTEND_URL=http://localhost:5173
GEONAMES_USERNAME=demo

# ============================================
# Frontend (React + Vite)
# ============================================
VITE_API_URL=http://localhost:3000/api

# ============================================
# Python Collector (Weather Data Collector)
# ============================================
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=weather-data
WEATHER_LOCATIONS=[{"name": "São Paulo, BR", "latitude": -23.5505, "longitude": -46.6333}, {"name": "Luanda, Angola", "latitude": -8.8383, "longitude": 13.2344}]
COLLECTION_INTERVAL_SECONDS=3600
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ============================================
# Go Worker (Message Queue Worker)
# ============================================
# RABBITMQ_URI já definido acima (reutilizado)
# RABBITMQ_QUEUE já definido acima (reutilizado)
NESTJS_API_URL=http://api:3000
RETRY_ATTEMPTS=3
RETRY_DELAY=5

# ============================================
# MongoDB
# ============================================
MONGO_INITDB_DATABASE=weather-dashboard

# ============================================
# RabbitMQ
# ============================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ============================================
# Notas Importantes
# ============================================
#
# 1. Para desenvolvimento local (sem Docker):
#    - MONGODB_URI: mongodb://localhost:27017/weather-dashboard
#    - RABBITMQ_URI: amqp://guest:guest@localhost:5672/
#    - NESTJS_API_URL: http://localhost:3000
#
# 2. Para produção:
#    - Altere JWT_SECRET para um valor seguro e único
#    - Use credenciais seguras para MongoDB e RabbitMQ
#    - Configure HTTPS para FRONTEND_URL
#
# 3. WEATHER_LOCATIONS:
#    - Formato JSON array com objetos contendo: name, latitude, longitude
#    - Exemplo: [{"name": "Cidade, País", "latitude": -23.5505, "longitude": -46.6333}]
#
# 4. COLLECTION_INTERVAL_SECONDS:
#    - Intervalo em segundos entre coletas de dados
#    - Padrão: 3600 (1 hora)
#
# 5. GEONAMES_USERNAME:
#    - Usuário para API GeoNames (usado no módulo explore)
#    - Use "demo" para testes ou crie conta em: https://www.geonames.org/login
#
