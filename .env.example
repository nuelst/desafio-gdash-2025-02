# ============================================
# Weather Dashboard - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e ajuste os valores conforme necessário

# ============================================
# BACKEND (NestJS)
# ============================================
NODE_ENV=development
API_PORT=3000
MONGODB_URI=mongodb://mongodb:27017/weather-dashboard
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=123456
FRONTEND_URL=http://localhost:5173

# ============================================
# FRONTEND (React + Vite)
# ============================================
VITE_API_URL=http://localhost:3000/api
VITE_DEFAULT_PASSWORD=root123

# ============================================
# PYTHON COLLECTOR
# ============================================
# URL do RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Nome da fila
RABBITMQ_QUEUE=weather-data

# Configuração de localizações (JSON)
# Formato: [{"name": "Nome da Cidade", "latitude": -23.55052, "longitude": -46.63330}, ...]
WEATHER_LOCATIONS=[{"name": "São Paulo, BR", "latitude": -23.55052, "longitude": -46.63330}, {"name": "Luanda, Angola", "latitude": -8.8383, "longitude": 13.2344}]

# Alternativa: usar variáveis individuais (para compatibilidade)
# WEATHER_LOCATION=São Paulo, BR
# LOCATION_LATITUDE=-23.5505
# LOCATION_LONGITUDE=-46.6333

# Intervalo de coleta em segundos (padrão: 3600 = 1 hora)
COLLECT_INTERVAL=3600

# URL da API Open-Meteo (opcional, padrão já configurado)
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ============================================
# GO WORKER
# ============================================
# URL do RabbitMQ
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672/
# Nome da fila
RABBITMQ_QUEUE=weather-data
# URL da API NestJS
NESTJS_API_URL=http://api:3000
# Tentativas de retry
RETRY_ATTEMPTS=3
# Delay entre tentativas (segundos)
RETRY_DELAY=5

# ============================================
# MONGODB
# ============================================
MONGO_INITDB_DATABASE=weather-dashboard

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ============================================
# GEONAMES API (para página Explorar)
# ============================================
# Crie uma conta gratuita em http://www.geonames.org/login
# e use seu username aqui para evitar limites da conta 'demo'

# ============================================
# GEONAMES API (para página Explorar)
# ============================================
# Crie uma conta gratuita em http://www.geonames.org/login
# e use seu username aqui para evitar limites da conta 'demo'
GEONAMES_USERNAME=demo
